# The gateway. Never point this at an individual service port — those have
# no authentication in front of them.
VITE_API_URL=http://localhost:8083

# TMDB v4 "API Read Access Token" (the long eyJ... one, not the v3 API key).
# Posters, backdrops and ratings come from TMDB in the browser; without it
# they silently render empty.
VITE_TMDB_TOKEN=
