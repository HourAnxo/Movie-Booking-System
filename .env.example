# Copy to .env and change both values before running this anywhere but your
# own machine. Compose falls back to the defaults below when .env is absent,
# which is why `docker compose up` works with no setup.

MYSQL_ROOT_PASSWORD=root

# Shared by api-gateway (verifies) and auth-service (signs). HS256 needs at
# least 32 bytes. If the two ever differ, every authenticated request fails
# at the gateway with a signature error.
JWT_SECRET=my-super-secret-key-for-movie-theater-project-2026-minimum-32-characters

# ---- Bakong KHQR (payment-service) ----
# Token: register an email at https://api-bakong.nbc.gov.kh. It expires about
# every 90 days. The Open API may only answer from Cambodian IP addresses.
# Account: the Bakong account that receives the money, e.g. yourname@aclb.
# Leave either empty and "Pay with Bakong" answers 503 instead of issuing a QR.
BAKONG_API_TOKEN=
BAKONG_ACCOUNT_ID=
BAKONG_MERCHANT_NAME=CineBook
# How long a QR stays payable before the booking is cancelled and the seat freed.
BAKONG_QR_TTL=5m
